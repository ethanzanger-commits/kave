# Neon: console.neon.tech -> new project -> copy the pooled connection string
DATABASE_URL=
AUTH_SECRET=
# LinkedIn: developer.linkedin.com -> app -> Products -> add "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
# Google redirect URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (email magic link)
AUTH_RESEND_KEY=
EMAIL_FROM=kave <onboarding@resend.dev>
# Your own sign-in email: unlocks /admin and demo people
ADMIN_EMAIL=
# Optional: smarter CV parsing with Claude (costs a few cents per CV)
ANTHROPIC_API_KEY=
# Public URL of the app (used in emails and invite links)
APP_URL=http://localhost:3000
# Free coffee requests are 3; then this many invited friends unlock everything (0 = no gate)
UNLOCK_INVITES=3
