# Neon: console.neon.tech -> new project -> copy the pooled connection string
DATABASE_URL=
AUTH_SECRET=
# LinkedIn: developer.linkedin.com -> app -> Products -> add "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
# Google redirect URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (email magic link)
AUTH_RESEND_KEY=
EMAIL_FROM=kave <onboarding@resend.dev>
# Your own sign-in email: unlocks /admin and demo people
ADMIN_EMAIL=
# Optional: smarter CV parsing with Claude (costs a few cents per CV)
ANTHROPIC_API_KEY=
# Public URL of the app (used in emails and invite links)
APP_URL=http://localhost:3000
# Free coffee requests are 3; then this many invited friends unlock everything (0 = no gate)
UNLOCK_INVITES=3
# Gmail sending (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Random string; Vercel sends it to the weekly email job
CRON_SECRET=

# Contact form: Formspree form ID (the part after /f/ in your form URL)
NEXT_PUBLIC_FORMSPREE_ID=
# Optional branded sending (Brevo or similar). Leave blank to keep using Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Kave <hello@yourdomain.com>
REPLY_TO=hello@yourdomain.com

# Phone notifications: run  npx web-push generate-vapid-keys  and paste both keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional free tools (each is off until its key is set)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
